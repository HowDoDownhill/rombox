{
  "name": "DuckStation",
  "android_package": "com.github.stenzek.duckstation",
  "android_play_store": true,
  "android_launch": {
    "activity": "com.github.stenzek.duckstation.EmulationActivity",
    "action": "android.intent.action.MAIN",
    "game": "document_extra:bootPath"
  },
  "executable_name": {
    "windows": "duckstation-qt-x64-ReleaseLTCG.exe",
    "linux": "DuckStation-x64.AppImage",
    "macos": "DuckStation.app/Contents/MacOS/DuckStation"
  },
  "emulator_dir_name": {
    "windows": "duckstation",
    "linux": "duckstation",
    "macos": "duckstation",
    "android": "duckstation"
  },
  "emulator_bios_path": {
    "windows": "bios",
    "linux": "bios",
    "macos": "home/Library/Application Support/DuckStation/bios"
  },
  "relative_save_path": {
    "psx": {
      "default": "memcards",
      "macos": "home/Library/Application Support/DuckStation/memcards"
    }
  },
  "launch_args_with_game": "-batch -fullscreen -- \"{rom_path}\"",
  "launch_args_without_game": "",
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "stenzek/duckstation",
      "asset_regex": ".*windows-x64-release\\.zip$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "stenzek/duckstation",
      "asset_regex": ".*DuckStation-x64\\.AppImage$",
      "extract": false
    },
    "macos": {
      "type": "github_release",
      "repo": "stenzek/duckstation",
      "asset_regex": "duckstation-mac-release\\.zip$",
      "extract": true
    }
  },
  "settings_fields": [
    {
      "id": "internal_resolution",
      "category": "Display",
      "label": "Internal Resolution",
      "type": "dropdown",
      "default_value_string": "1",
      "config_file_relative_path": {
        "default": "settings.ini",
        "macos": "home/Library/Application Support/DuckStation/settings.ini"
      },
      "config_section": "GPU",
      "config_key": "ResolutionScale",
      "options": {
        "Native (1x)": "1",
        "720p (2x)": "2",
        "1080p (3x)": "3",
        "1440p (4x)": "4",
        "1620p (5x)": "5",
        "2160p (6x)": "6",
        "2880p (8x)": "8"
      }
    },
    {
      "id": "aspect_ratio",
      "category": "Display",
      "label": "Aspect Ratio",
      "type": "dropdown",
      "default_value_string": "Auto (Game Native)",
      "config_file_relative_path": {
        "default": "settings.ini",
        "macos": "home/Library/Application Support/DuckStation/settings.ini"
      },
      "config_section": "Display",
      "config_key": "AspectRatio",
      "options": {
        "Auto (Game Native)": "Auto (Game Native)",
        "Standard (4:3)": "4:3",
        "Widescreen (16:9)": "16:9",
        "Stretch to Window": "Stretch To Fill"
      }
    },
    {
      "id": "per_game_memcard",
      "label": "Per-Game Memory Card",
      "type": "hidden",
      "default_value_string": "PerGameTitle",
      "config_file_relative_path": {
        "default": "settings.ini",
        "macos": "home/Library/Application Support/DuckStation/settings.ini"
      },
      "config_section": "MemoryCards",
      "config_key": "Card1Type"
    },
    {
      "id": "vsync",
      "category": "Display",
      "label": "VSync",
      "type": "dropdown",
      "default_value_string": "false",
      "config_file_relative_path": {
        "default": "settings.ini",
        "macos": "home/Library/Application Support/DuckStation/settings.ini"
      },
      "config_section": "Display",
      "config_key": "VSync",
      "options": {
        "Off": "false",
        "On": "true"
      }
    },
    {
      "id": "multitap",
      "category": "Controllers",
      "label": "Multitap (Up to 4 Players)",
      "type": "dropdown",
      "default_value_string": "off",
      "options": {
        "Off": "off",
        "In Port 1": "port1",
        "In Port 2": "port2"
      }
    }
  ],
  "controller_config": {
    "max_controllers": 2,
    "port_layouts": {
      "setting_id": "multitap",
      "layouts": {
        "off": {
          "ports": [1, 2],
          "config_values": { "ControllerPorts/MultitapMode": "Disabled" }
        },
        "port1": {
          "ports": [1, 3, 4, 5, 2],
          "config_values": { "ControllerPorts/MultitapMode": "Port1Only" }
        },
        "port2": {
          "ports": [1, 2, 6, 7, 8],
          "config_values": { "ControllerPorts/MultitapMode": "Port2Only" }
        }
      }
    },
    "config_file_relative_path": {
      "default": "settings.ini",
      "macos": "home/Library/Application Support/DuckStation/settings.ini"
    },
    "format": "ini",
    "platform_layout": {
      "D-Pad Up": "DpadUp",
      "D-Pad Down": "DpadDown",
      "D-Pad Left": "DpadLeft",
      "D-Pad Right": "DpadRight",
      "Triangle": "FaceNorth",
      "Circle": "FaceEast",
      "Cross": "FaceSouth",
      "Square": "FaceWest",
      "Select": "Back",
      "Start": "Start",
      "Analog Button": "Guide",
      "L1": "LeftShoulder",
      "R1": "RightShoulder",
      "L2": "LeftTrigger",
      "R2": "RightTrigger",
      "L3": "LeftStick",
      "R3": "RightStick",
      "Left Stick Up": "LeftStick_Up",
      "Left Stick Down": "LeftStick_Down",
      "Left Stick Left": "LeftStick_Left",
      "Left Stick Right": "LeftStick_Right",
      "Right Stick Up": "RightStick_Up",
      "Right Stick Down": "RightStick_Down",
      "Right Stick Left": "RightStick_Left",
      "Right Stick Right": "RightStick_Right"
    },
    "sdl_string_map": {
      "FaceSouth": "FaceSouth",
      "FaceEast": "FaceEast",
      "FaceWest": "FaceWest",
      "FaceNorth": "FaceNorth",
      "LeftShoulder": "LeftShoulder",
      "RightShoulder": "RightShoulder",
      "LeftTrigger": "+LeftTrigger",
      "RightTrigger": "+RightTrigger",
      "DpadUp": "DPadUp",
      "DpadDown": "DPadDown",
      "DpadLeft": "DPadLeft",
      "DpadRight": "DPadRight",
      "Back": "Back",
      "Start": "Start",
      "Guide": "Guide",
      "LeftStick": "LeftStick",
      "RightStick": "RightStick",
      "LeftStick_Up": "-LeftY",
      "LeftStick_Down": "+LeftY",
      "LeftStick_Left": "-LeftX",
      "LeftStick_Right": "+LeftX",
      "RightStick_Up": "-RightY",
      "RightStick_Down": "+RightY",
      "RightStick_Left": "-RightX",
      "RightStick_Right": "+RightX"
    },
    "controller_sections": [
      {
        "section_template": "Pad{port}",
        "port_start": 1,
        "type_key": "Type",
        "type_connected": "AnalogController",
        "type_disconnected": "None",
        "mappings": {
          "Up": "SDL-{sdl_player_index}/{Platform_D-Pad Up}",
          "Right": "SDL-{sdl_player_index}/{Platform_D-Pad Right}",
          "Down": "SDL-{sdl_player_index}/{Platform_D-Pad Down}",
          "Left": "SDL-{sdl_player_index}/{Platform_D-Pad Left}",
          "Triangle": "SDL-{sdl_player_index}/{Platform_Triangle}",
          "Circle": "SDL-{sdl_player_index}/{Platform_Circle}",
          "Cross": "SDL-{sdl_player_index}/{Platform_Cross}",
          "Square": "SDL-{sdl_player_index}/{Platform_Square}",
          "Select": "SDL-{sdl_player_index}/{Platform_Select}",
          "Start": "SDL-{sdl_player_index}/{Platform_Start}",
          "Analog": "SDL-{sdl_player_index}/{Platform_Analog Button}",
          "L1": "SDL-{sdl_player_index}/{Platform_L1}",
          "R1": "SDL-{sdl_player_index}/{Platform_R1}",
          "L2": "SDL-{sdl_player_index}/{Platform_L2}",
          "R2": "SDL-{sdl_player_index}/{Platform_R2}",
          "L3": "SDL-{sdl_player_index}/{Platform_L3}",
          "R3": "SDL-{sdl_player_index}/{Platform_R3}",
          "LUp": "SDL-{sdl_player_index}/{Platform_Left Stick Up}",
          "LDown": "SDL-{sdl_player_index}/{Platform_Left Stick Down}",
          "LLeft": "SDL-{sdl_player_index}/{Platform_Left Stick Left}",
          "LRight": "SDL-{sdl_player_index}/{Platform_Left Stick Right}",
          "RUp": "SDL-{sdl_player_index}/{Platform_Right Stick Up}",
          "RDown": "SDL-{sdl_player_index}/{Platform_Right Stick Down}",
          "RLeft": "SDL-{sdl_player_index}/{Platform_Right Stick Left}",
          "RRight": "SDL-{sdl_player_index}/{Platform_Right Stick Right}",
          "LargeMotor": "SDL-{sdl_player_index}/LargeMotor",
          "SmallMotor": "SDL-{sdl_player_index}/SmallMotor"
        },
        "device_binding_pattern": "SDL-\\d+/",
        "device_binding_template": "SDL-{sdl_player_index}/"
      }
    ]
  },
  "launch_env": {
    "macos": {
      "HOME": "{emulator_dir}/home"
    }
  }
}
