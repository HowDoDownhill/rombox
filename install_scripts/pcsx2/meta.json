{
  "name": "PCSX2",
  "android_name": "ARMSX2",
  "android_package": "com.armsx2",
  "android_launch": {"activity": "com.armsx2.MainActivity", "game": "document"},
  "executable_name": {
    "windows": "pcsx2-qt.exe"
  },
  "executable_regex": {
    "linux": "PCSX2-.*-anylinux-x86_64\\.AppImage$",
    "macos": "^PCSX2.*\\.app/Contents/MacOS/PCSX2$"
  },
  "emulator_dir_name": {
    "windows": "pcsx2",
    "linux": "pcsx2",
    "macos": "pcsx2",
    "android": "pcsx2"
  },
  "emulator_bios_path": {
    "windows": "bios",
    "linux": "bios",
    "macos": "bios"
  },
  "relative_save_path": {
    "ps2": "memcards"
  },
  "launch_args_with_game": "-batch -fullscreen -portable -bigpicture -- \"{rom_path}\"",
  "launch_args_without_game": "-portable",
  "install_recipe": {
    "windows": {
      "type": "github_release",
      "repo": "PCSX2/pcsx2",
      "asset_regex": ".*windows-x64-Qt\\.7z$",
      "extract": true
    },
    "linux": {
      "type": "github_release",
      "repo": "pkgforge-dev/PCSX2-AppImage-Enhanced",
      "asset_regex": "PCSX2-.*-anylinux-x86_64\\.AppImage$",
      "extract": false
    },
    "macos": {
      "type": "github_release",
      "repo": "PCSX2/pcsx2",
      "asset_regex": "pcsx2-.*-macos-Qt\\.tar\\.xz$",
      "extract": true
    },
    "android": {
      "type": "github_release",
      "repo": "ARMSX2/ARMSX2",
      "asset_regex": "ARMSX2-.*-a11-armv8\\.2-sdk30\\.apk$",
      "extract": false
    }
  },
  "settings_fields": [
    {
      "id": "internal_resolution",
      "category": "Display",
      "label": "Internal Resolution",
      "type": "dropdown",
      "default_value_string": "1",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "upscale_multiplier",
      "options": {
        "Native (1x)": "1",
        "720p (2x)": "2",
        "1080p (3x)": "3",
        "1440p (4x)": "4",
        "2160p (6x)": "6",
        "2880p (8x)": "8"
      }
    },
    {
      "id": "aspect_ratio",
      "category": "Display",
      "label": "Aspect Ratio",
      "type": "dropdown",
      "default_value_string": "Auto 4:3/3:2",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "AspectRatio",
      "options": {
        "Auto 4:3/3:2": "Auto 4:3/3:2",
        "Standard (4:3)": "4:3",
        "Widescreen (16:9)": "16:9",
        "Stretch": "Stretch"
      }
    },
    {
      "id": "per_game_memcard",
      "label": "Per-Game Memory Card",
      "type": "hidden",
      "default_value_string": "RomM_{game_id}.ps2",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "MemoryCards",
      "config_key": "Slot1_Filename"
    },
    {
      "id": "vsync",
      "category": "Display",
      "label": "VSync",
      "type": "dropdown",
      "default_value_string": "0",
      "config_file_relative_path": {
        "windows": "inis/PCSX2.ini",
        "linux": "PCSX2/inis/PCSX2.ini",
        "macos": "inis/PCSX2.ini"
      },
      "config_section": "EmuCore/GS",
      "config_key": "VsyncEnable",
      "options": {
        "Off": "0",
        "Standard": "1"
      }
    },
    {
      "id": "multitap",
      "category": "Controllers",
      "label": "Multitap (Up to 4 Players)",
      "type": "dropdown",
      "default_value_string": "off",
      "options": {
        "Off": "off",
        "In Port 1": "port1",
        "In Port 2": "port2"
      }
    }
  ],
  "controller_config": {
    "max_controllers": 2,
    "port_layouts": {
      "setting_id": "multitap",
      "layouts": {
        "off": {
          "ports": [1, 2],
          "config_values": { "Pad/MultitapPort1": "false", "Pad/MultitapPort2": "false" }
        },
        "port1": {
          "ports": [1, 3, 4, 5, 2],
          "config_values": { "Pad/MultitapPort1": "true", "Pad/MultitapPort2": "false" }
        },
        "port2": {
          "ports": [1, 2, 6, 7, 8],
          "config_values": { "Pad/MultitapPort1": "false", "Pad/MultitapPort2": "true" }
        }
      }
    },
    "config_file_relative_path": {
      "windows": "inis/PCSX2.ini",
      "linux": "PCSX2/inis/PCSX2.ini",
      "macos": "inis/PCSX2.ini"
    },
    "format": "ini",
    "platform_layout": {
      "D-Pad Up": "DpadUp",
      "D-Pad Down": "DpadDown",
      "D-Pad Left": "DpadLeft",
      "D-Pad Right": "DpadRight",
      "Triangle": "FaceNorth",
      "Circle": "FaceEast",
      "Cross": "FaceSouth",
      "Square": "FaceWest",
      "Select": "Back",
      "Start": "Start",
      "Analog Button": "Guide",
      "L1": "LeftShoulder",
      "R1": "RightShoulder",
      "L2": "LeftTrigger",
      "R2": "RightTrigger",
      "L3": "LeftStick",
      "R3": "RightStick",
      "Left Stick Up": "LeftStick_Up",
      "Left Stick Down": "LeftStick_Down",
      "Left Stick Left": "LeftStick_Left",
      "Left Stick Right": "LeftStick_Right",
      "Right Stick Up": "RightStick_Up",
      "Right Stick Down": "RightStick_Down",
      "Right Stick Left": "RightStick_Left",
      "Right Stick Right": "RightStick_Right"
    },
    "sdl_string_map": {
      "FaceSouth": "FaceSouth",
      "FaceEast": "FaceEast",
      "FaceWest": "FaceWest",
      "FaceNorth": "FaceNorth",
      "LeftShoulder": "LeftShoulder",
      "RightShoulder": "RightShoulder",
      "LeftTrigger": "+LeftTrigger",
      "RightTrigger": "+RightTrigger",
      "DpadUp": "DPadUp",
      "DpadDown": "DPadDown",
      "DpadLeft": "DPadLeft",
      "DpadRight": "DPadRight",
      "Back": "Back",
      "Start": "Start",
      "Guide": "Guide",
      "LeftStick": "LeftStick",
      "RightStick": "RightStick",
      "LeftStick_Up": "-LeftY",
      "LeftStick_Down": "+LeftY",
      "LeftStick_Left": "-LeftX",
      "LeftStick_Right": "+LeftX",
      "RightStick_Up": "-RightY",
      "RightStick_Down": "+RightY",
      "RightStick_Left": "-RightX",
      "RightStick_Right": "+RightX"
    },
    "controller_sections": [
      {
        "section_template": "Pad{port}",
        "port_start": 1,
        "type_key": "Type",
        "type_connected": "DualShock2",
        "type_disconnected": "None",
        "mappings": {
          "Up": "SDL-{sdl_player_index}/{Platform_D-Pad Up}",
          "Right": "SDL-{sdl_player_index}/{Platform_D-Pad Right}",
          "Down": "SDL-{sdl_player_index}/{Platform_D-Pad Down}",
          "Left": "SDL-{sdl_player_index}/{Platform_D-Pad Left}",
          "Select": "SDL-{sdl_player_index}/{Platform_Select}",
          "Start": "SDL-{sdl_player_index}/{Platform_Start}",
          "L1": "SDL-{sdl_player_index}/{Platform_L1}",
          "L2": "SDL-{sdl_player_index}/{Platform_L2}",
          "R1": "SDL-{sdl_player_index}/{Platform_R1}",
          "R2": "SDL-{sdl_player_index}/{Platform_R2}",
          "L3": "SDL-{sdl_player_index}/{Platform_L3}",
          "R3": "SDL-{sdl_player_index}/{Platform_R3}",
          "LUp": "SDL-{sdl_player_index}/{Platform_Left Stick Up}",
          "LRight": "SDL-{sdl_player_index}/{Platform_Left Stick Right}",
          "LDown": "SDL-{sdl_player_index}/{Platform_Left Stick Down}",
          "LLeft": "SDL-{sdl_player_index}/{Platform_Left Stick Left}",
          "RUp": "SDL-{sdl_player_index}/{Platform_Right Stick Up}",
          "RRight": "SDL-{sdl_player_index}/{Platform_Right Stick Right}",
          "RDown": "SDL-{sdl_player_index}/{Platform_Right Stick Down}",
          "RLeft": "SDL-{sdl_player_index}/{Platform_Right Stick Left}",
          "Analog": "SDL-{sdl_player_index}/{Platform_Analog Button}",
          "LargeMotor": "SDL-{sdl_player_index}/LargeMotor",
          "SmallMotor": "SDL-{sdl_player_index}/SmallMotor",
          "Triangle": "SDL-{sdl_player_index}/{Platform_Triangle}",
          "Circle": "SDL-{sdl_player_index}/{Platform_Circle}",
          "Cross": "SDL-{sdl_player_index}/{Platform_Cross}",
          "Square": "SDL-{sdl_player_index}/{Platform_Square}"
        },
        "static_values": {
          "Deadzone": "0.000000",
          "AxisScale": "1.330000",
          "LargeMotorScale": "1.000000",
          "SmallMotorScale": "1.000000",
          "PressureModifier": "0.5"
        },
        "device_binding_pattern": "SDL-\\d+/",
        "device_binding_template": "SDL-{sdl_player_index}/"
      }
    ]
  }
}
